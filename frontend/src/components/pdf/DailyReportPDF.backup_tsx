import React from "react";
import { Document, Page, Text, View, StyleSheet } from "@react-pdf/renderer";
import type { Project } from "@/types/entities";
import type { GlobalStatistics } from "@/types/stores";
import { format } from "date-fns";
import { translations, DEFAULT_LOCALE, type Locale } from "@/i18n/translations";
import { es, enUS, fr as frLocale } from "date-fns/locale";

// Monochromatic styles - clean and professional
const styles = StyleSheet.create({
  page: {
    padding: 40,
    fontSize: 10,
    fontFamily: "Helvetica",
    backgroundColor: "#ffffff",
  },
  header: {
    marginBottom: 30,
    paddingBottom: 20,
    borderBottom: "3 solid #000000",
  },
  title: {
    fontSize: 28,
    fontWeight: "bold",
    marginBottom: 8,
    color: "#000000",
    letterSpacing: 1,
  },
  subtitle: {
    fontSize: 12,
    color: "#333333",
    marginBottom: 4,
    fontWeight: "normal",
  },
  dateBadge: {
    backgroundColor: "#000000",
    color: "#ffffff",
    padding: "8 16",
    fontSize: 11,
    fontWeight: "bold",
    marginTop: 8,
  },
  section: {
    marginBottom: 25,
    width: "100%",
    minHeight: 0,
  },
  sectionHeader: {
    fontSize: 10,
    fontWeight: "bold",
    marginBottom: 10,
    color: "#000000",
    borderBottom: "2 solid #000000",
    paddingBottom: 6,
    textTransform: "uppercase",
    letterSpacing: 0.5,
  },
  projectCard: {
    marginBottom: 10,
    padding: 10,
    border: "1 solid #000000",
    backgroundColor: "#fafafa",
    minHeight: 50,
  },
  projectTitle: {
    fontSize: 11,
    fontWeight: "bold",
    marginBottom: 5,
    color: "#000000",
  },
  projectRow: {
    flexDirection: "row",
    marginBottom: 3,
  },
  projectLabel: {
    width: "35%",
    fontWeight: "bold",
    color: "#333333",
    fontSize: 8,
  },
  projectValue: {
    width: "65%",
    color: "#000000",
    fontSize: 8,
  },
  projectDescription: {
    marginTop: 5,
    paddingTop: 5,
    borderTop: "1 solid #cccccc",
    color: "#333333",
    fontSize: 8,
    lineHeight: 1.3,
  },
  emptyState: {
    padding: 20,
    textAlign: "center",
    color: "#666666",
    fontSize: 10,
    fontStyle: "italic",
  },
  statsBox: {
    flexDirection: "row",
    justifyContent: "space-between",
    marginBottom: 25,
    padding: 15,
    backgroundColor: "#f5f5f5",
    border: "1 solid #000000",
    flexWrap: "wrap",
  },
  statItem: {
    alignItems: "center",
    width: "24%",
    minWidth: 0,
    paddingHorizontal: 5,
  },
  statNumber: {
    fontSize: 24,
    fontWeight: "bold",
    color: "#000000",
    marginBottom: 4,
  },
  statLabel: {
    fontSize: 6,
    color: "#666666",
    textTransform: "uppercase",
    letterSpacing: 0.3,
    textAlign: "center",
    lineHeight: 1.2,
  },
  footer: {
    position: "absolute",
    bottom: 30,
    left: 40,
    right: 40,
    textAlign: "center",
    fontSize: 8,
    color: "#666666",
    borderTop: "1 solid #cccccc",
    paddingTop: 10,
  },
  table: {
    width: "100%",
    marginBottom: 10,
    border: "1 solid #000000",
  },
  tableHeader: {
    flexDirection: "row",
    backgroundColor: "#000000",
    color: "#ffffff",
    fontWeight: "bold",
    fontSize: 8,
    padding: 6,
    borderBottom: "1 solid #000000",
  },
  tableRow: {
    flexDirection: "row",
    borderBottom: "1 solid #cccccc",
    fontSize: 7,
    padding: 4,
    minHeight: 20,
  },
  tableRowEven: {
    backgroundColor: "#fafafa",
  },
  tableCell: {
    padding: "4 6",
    fontSize: 7,
    color: "#000000",
  },
  tableCellHeader: {
    padding: "4 6",
    fontSize: 8,
    fontWeight: "bold",
    color: "#ffffff",
  },
  grandTotalCard: {
    marginTop: 10,
    padding: 12,
    backgroundColor: "#f5f5f5",
    border: "2 solid #000000",
    borderRadius: 4,
    minHeight: 40,
  },
  grandTotalText: {
    fontSize: 10,
    fontWeight: "bold",
    color: "#000000",
  },
  projectNameHeader: {
    fontSize: 12,
    fontWeight: "bold",
    marginBottom: 8,
    color: "#000000",
    paddingBottom: 4,
    borderBottom: "1 solid #cccccc",
  },
});

interface ProjectUserHours {
  userId: number;
  userName: string;
  hours: number;
}

interface DailyReportPDFProps {
  createdToday: Project[];
  scheduledToday: Project[];
  representativesCreatedToday: any[];
  representativesScheduledToday: any[];
  representativesEvaluationsScheduledToday: any[];
  representativesEvaluatedToday: any[];
  representativesRejectedToday: any[];
  totalTools: number;
  totalTeams: number;
  inProgressProjects: any[];
  globalStats?: GlobalStatistics | null;
  date: Date;
  projectHours?: Record<number, number>;
  projectUserHours?: Record<number, ProjectUserHours[]>;
  locale?: Locale;
}

const DailyReportPDF: React.FC<DailyReportPDFProps> = ({ 
  createdToday, 
  scheduledToday, 
  representativesCreatedToday,
  representativesScheduledToday,
  representativesEvaluationsScheduledToday,
  representativesEvaluatedToday,
  representativesRejectedToday,
  totalTools: _totalTools,
  totalTeams: _totalTeams,
  inProgressProjects,
  globalStats,
  date,
  projectHours = {},
  projectUserHours = {},
  locale = DEFAULT_LOCALE
}) => {
  // Ensure locale is valid, fallback to DEFAULT_LOCALE if not
  const validLocale: Locale = (locale && (locale === "en" || locale === "es" || locale === "fr")) 
    ? (locale as Locale) 
    : DEFAULT_LOCALE;
  
  // Get locale-specific date formatter
  const dateLocaleMap: Record<Locale, typeof es> = {
    es: es,
    en: enUS,
    fr: frLocale,
  };
  const dateLocale = dateLocaleMap[validLocale] || es;

  // Safe access to translations with fallback (using validLocale from above)
  const dailyReportTranslations = (translations[validLocale] as any)?.statistics?.dailyReportPDF;
  const t = (dailyReportTranslations || (translations["en"] as any)?.statistics?.dailyReportPDF) as any;
  
  // Ensure t has required structure with fallbacks
  const safeT = {
    header: t?.header || { title: "Daily Report", subtitle: "Project Management System" },
    stats: t?.stats || {
      projectsCreated: "Projects Created",
      projectsScheduled: "Projects Scheduled",
      projectsTotal: "Total Projects",
    },
    sections: t?.sections || {
      createdToday: "Projects Created Today",
      scheduledToday: "Projects Scheduled for Today",
      noCreated: "No projects were created today.",
      noScheduled: "No projects are scheduled for today.",
      hoursByProject: "Hours by Project",
      noUserHours: "No hours recorded for this project.",
      overallGrandTotal: "Overall Grand Total",
    },
    labels: t?.labels || {
      status: "Status:",
      scheduledStart: "Scheduled Start:",
      location: "Location:",
      createdBy: "Created By:",
      createdAt: "Created At:",
      totalHours: "Total Hours Worked:",
      contact: "Contact:",
      client: "Client:",
      visitDate: "Visit Date:",
      evaluationScheduled: "Evaluation Scheduled:",
      finished: "Finished:",
      evaluator: "Evaluator:",
      rejected: "Rejected:",
      user: "User",
      hours: "Hours",
    },
    representatives: t?.representatives || {
      title: "Representatives",
      stats: {
        created: "Created",
        scheduled: "Scheduled",
        total: "Total",
      },
      sections: {
        createdToday: "Created Today",
        scheduledToday: "Scheduled for Today",
        noCreated: "No representatives were created today.",
        noScheduled: "No representatives are scheduled for today.",
      },
    },
    evaluations: t?.evaluations || {
      title: "Evaluations",
      stats: {
        scheduled: "Scheduled",
        finished: "Finished",
        rejected: "Rejected",
      },
      sections: {
        scheduledToday: "Evaluations Scheduled for Today",
        finishedToday: "Evaluations Finished",
        rejectedToday: "Rejected Today",
        noScheduled: "No evaluations are scheduled for today.",
        noFinished: "No evaluations were finished today.",
        noRejected: "No representatives were rejected today.",
      },
    },
    toolsAndTeams: {
      title: t?.toolsAndTeams?.title || "Tools and Teams",
      stats: {
        tools: t?.toolsAndTeams?.stats?.tools || "Tools",
        teams: t?.toolsAndTeams?.stats?.teams || "Teams",
      },
      sections: {
        ongoingProjects: t?.toolsAndTeams?.sections?.ongoingProjects || "Tools and Teams by Projects",
        noInProgress: t?.toolsAndTeams?.sections?.noInProgress || "No projects are currently in progress.",
      },
      fields: {
        noTeamAssigned: t?.toolsAndTeams?.fields?.noTeamAssigned || "No team assigned",
        noToolsAssigned: t?.toolsAndTeams?.fields?.noToolsAssigned || "No tools assigned",
      },
    },
    status: t?.status || {
      active: "Active",
      finished: "Finished",
      cancelled: "Cancelled",
    },
    common: t?.common || {
      untitled: "Untitled",
      unknown: "Unknown",
      generatedOn: "Generated on",
    },
    overview: t?.overview || {
      title: "All-Time Overview",
      projects: {
        total: "Projects Total",
        active: "Projects Active",
        finished: "Projects Finished",
        cancelled: "Projects Cancelled",
      },
      representatives: {
        total: "Representatives Total",
        evaluated: "Representatives Evaluated",
        rejected: "Representatives Rejected",
      },
      evaluations: {
        scheduled: "Evaluations Scheduled",
        finished: "Evaluations Finished",
      },
      resources: {
        teamsTotal: "Teams Total",
        teamsOnActiveProjects: "Teams on Ongoing Projects",
        toolsTotal: "Tools Total",
        toolsInUse: "Tools In Use",
      },
    },
  };
  

  const formatDateShort = (date: Date | null | undefined) => {
    if (!date) return "N/A";
    return format(new Date(date), "MMM dd, yyyy 'at' HH:mm", { locale: dateLocale });
  };

  const formatDateLong = (date: Date) => {
    return format(new Date(date), "EEEE, MMMM dd, yyyy", { locale: dateLocale });
  };

  const formatDateFooter = (date: Date) => {
    return format(new Date(date), "PPP 'at' p", { locale: dateLocale });
  };

  const renderStatBlock = (label: string, value: string | number) => (
    <View style={[styles.statItem, { width: "23%", marginBottom: 10 }]}>
      <Text style={[styles.statNumber, { fontSize: 16 }]}>{value}</Text>
      <Text style={[styles.statLabel, { fontSize: 7 }]}>{label.toUpperCase()}</Text>
    </View>
  );

  const renderTable = (
    headers: string[],
    widths: string[],
    rows: any[][],
    emptyMessage: string
  ) => {
    if (rows.length === 0) {
      return (
        <View style={styles.emptyState}>
          <Text>{emptyMessage}</Text>
        </View>
      );
    }

    // Normalize widths to ensure they sum properly
    const normalizedWidths = widths.map(w => {
      if (w.endsWith('%')) {
        return w;
      }
      return `${100 / headers.length}%`;
    });

    return (
      <View style={styles.table} wrap={false}>
        {/* Table Header */}
        <View style={styles.tableHeader} wrap={false}>
          {headers.map((header, index) => (
            <View
              key={index}
              style={[
                { width: normalizedWidths[index] || `${100 / headers.length}%` },
              ]}
            >
              <Text style={styles.tableCellHeader}>
                {header}
              </Text>
            </View>
          ))}
        </View>
        {/* Table Rows */}
        {rows.map((row, rowIndex) => (
          <View
            key={rowIndex}
            wrap={false}
            style={[
              styles.tableRow,
              rowIndex % 2 === 1 ? styles.tableRowEven : {},
            ]}
          >
            {row.map((cell, cellIndex) => (
              <View
                key={cellIndex}
                style={[
                  { width: normalizedWidths[cellIndex] || `${100 / headers.length}%` },
                ]}
              >
                <Text style={styles.tableCell}>
                  {cell || "N/A"}
                </Text>
              </View>
            ))}
          </View>
        ))}
      </View>
    );
  };

  const renderProjectUserHours = () => {
    // Get all active projects for the date
    const allProjects = [
      ...createdToday,
      ...scheduledToday,
      ...inProgressProjects,
    ];
    
    // Remove duplicates by project ID
    const uniqueProjects = Array.from(
      new Map(allProjects.map((project) => [project.id, project])).values()
    );
    
    // Filter to only projects that have user hours data
    const projectsWithHours = uniqueProjects.filter(
      (project) => projectUserHours[project.id] && projectUserHours[project.id].length > 0
    );

    if (projectsWithHours.length === 0) return null;

    // Calculate grand totals
    let grandTotalHours = 0;
    const userTotals: Record<string, number> = {};
    
    projectsWithHours.forEach((project) => {
      const userHours = projectUserHours[project.id] || [];
      userHours.forEach((entry) => {
        grandTotalHours += entry.hours;
        userTotals[entry.userName] = (userTotals[entry.userName] || 0) + entry.hours;
      });
    });

    return (
      <View style={{ marginTop: 25 }} wrap={false}>
        <Text style={[styles.sectionHeader, { fontSize: 14, marginBottom: 15 }]}>
          {safeT.sections.hoursByProject}
        </Text>
        
        {projectsWithHours.map((project) => {
          const userHours = projectUserHours[project.id] || [];
          const totalProjectHours = userHours.reduce((sum, entry) => sum + entry.hours, 0);

          return (
            <View key={project.id} style={[styles.section, { marginBottom: 25 }]} wrap={false}>
              {/* Project Name */}
              <Text style={styles.projectNameHeader}>
                {project.title || safeT.common.untitled} {project.location ? `- ${project.location}` : ""}
              </Text>
              
              {/* Project Table */}
              {userHours.length > 0 ? (
                <View wrap={false}>
                  {renderTable(
                    [safeT.labels.user, safeT.labels.hours],
                    ["70%", "30%"],
                    userHours.map((entry) => [
                      entry.userName || safeT.common.unknown,
                      `${entry.hours.toFixed(2)}h`,
                    ]),
                    safeT.sections.noUserHours
                  )}
                  
                  {/* Grand Total Card for this project */}
                  <View style={styles.grandTotalCard} wrap={false}>
                    <View wrap={false} style={{ flexDirection: "row", justifyContent: "space-between" }}>
                      <Text style={styles.grandTotalText}>
                        {safeT.labels.totalHoursShort.replace(":", "")}:
                      </Text>
                      <Text style={styles.grandTotalText}>
                        {totalProjectHours.toFixed(2)}h
                      </Text>
                    </View>
                  </View>
                </View>
              ) : (
                <View style={styles.emptyState}>
                  <Text>{safeT.sections.noUserHours}</Text>
                </View>
              )}
            </View>
          );
        })}
        
        {/* Overall Grand Total Card */}
        {grandTotalHours > 0 && (
          <View style={[styles.grandTotalCard, { marginTop: 20 }]} wrap={false}>
            <View wrap={false}>
              <Text style={[styles.grandTotalText, { marginBottom: 8 }]}>
                {safeT.sections.overallGrandTotal}
              </Text>
              <View wrap={false} style={{ flexDirection: "row", justifyContent: "space-between", marginBottom: 6 }}>
                <Text style={styles.grandTotalText}>
                  Total Hours:
                </Text>
                <Text style={styles.grandTotalText}>
                  {grandTotalHours.toFixed(2)}h
                </Text>
              </View>
              {Object.keys(userTotals).length > 0 && (
                <View wrap={false} style={{ marginTop: 8, paddingTop: 8, borderTop: "1 solid #cccccc" }}>
                  {Object.entries(userTotals)
                    .sort((a, b) => b[1] - a[1])
                    .map(([userName, total]) => (
                      <View key={userName} wrap={false} style={{ flexDirection: "row", justifyContent: "space-between", marginBottom: 4 }}>
                        <Text style={{ fontSize: 9, color: "#333333" }}>{userName}:</Text>
                        <Text style={{ fontSize: 9, color: "#333333", fontWeight: "bold" }}>{total.toFixed(2)}h</Text>
                      </View>
                    ))}
                </View>
              )}
            </View>
          </View>
        )}
      </View>
    );
  };

  const renderGlobalSection = () => {
    if (!globalStats) return null;

    return (
      <View style={{ marginTop: 25 }}>
        <Text style={[styles.sectionHeader, { fontSize: 14, marginBottom: 15 }]}>
          {safeT.overview.title}
        </Text>
        
        <View style={[styles.statsBox, { marginBottom: 15 }]}>
          {renderStatBlock(safeT.overview.projects.total, globalStats.totalProjects)}
          {renderStatBlock(safeT.overview.projects.active, globalStats.activeProjects)}
          {renderStatBlock(safeT.overview.projects.finished, globalStats.finishedProjects)}
          {renderStatBlock(safeT.overview.projects.cancelled, globalStats.cancelledProjects)}
        </View>

        {/* <View style={[styles.statsBox, { marginBottom: 15 }]}>
          {renderStatBlock(safeT.overview.representatives.total, globalStats.totalRepresentatives)}
          {renderStatBlock(
            safeT.overview.representatives.evaluated,
            globalStats.evaluatedRepresentatives
          )}
          {renderStatBlock(
            safeT.overview.representatives.rejected,
            globalStats.rejectedRepresentatives
          )}
        </View>

        <View style={[styles.statsBox, { marginBottom: 15 }]}>
          {renderStatBlock(safeT.overview.evaluations.scheduled, globalStats.evaluationsScheduled)}
          {renderStatBlock(safeT.overview.evaluations.finished, globalStats.evaluationsFinished)}
        </View>

        <View style={[styles.statsBox, { marginBottom: 15 }]}>
          {renderStatBlock(safeT.overview.resources.teamsTotal, globalStats.totalTeams)}
          {renderStatBlock(
            safeT.overview.resources.teamsOnActiveProjects,
            globalStats.teamsOnActiveProjects
          )}
          {renderStatBlock(safeT.overview.resources.toolsTotal, globalStats.totalTools)}
          {renderStatBlock(safeT.overview.resources.toolsInUse, toolsInUseRatio)}
        </View> */}
      </View>
    );
  };

  return (
    <Document>
      <Page size="A4" style={styles.page} wrap>
        {/* Header */}
        <View style={styles.header}>
          <Text style={styles.title}>{safeT.header.title}</Text>
          <View>
            <Text style={styles.dateBadge}>{formatDateLong(date)}</Text>
          </View>
        </View>

        {/* Statistics */}
        <View style={styles.statsBox}>
          <View style={styles.statItem}>
            <Text style={styles.statNumber}>{createdToday.length}</Text>
            <Text style={styles.statLabel}>{safeT.stats.projectsCreated}</Text>
          </View>
          <View style={styles.statItem}>
            <Text style={styles.statNumber}>{scheduledToday.length}</Text>
            <Text style={styles.statLabel}>{safeT.stats.projectsScheduled}</Text>
          </View>
          <View style={styles.statItem}>
            <Text style={styles.statNumber}>{createdToday.length + scheduledToday.length}</Text>
            <Text style={styles.statLabel}>{safeT.stats.projectsTotal}</Text>
          </View>
        </View>

        {/* Projects Created Today */}
        <View style={styles.section}>
          <Text style={styles.sectionHeader}>
          {safeT.sections.createdToday} ({createdToday.length})
          </Text>
          {renderTable(
            [
              safeT.labels.status.replace(":", ""),
              "Title",
              safeT.labels.location.replace(":", ""),
              safeT.labels.createdBy.replace(":", ""),
              safeT.labels.totalHours.replace(":", ""),
            ],
            ["15%", "25%", "20%", "20%", "20%"],
            createdToday.map((project) => [
              project.status || "N/A",
              project.title || safeT.common.untitled,
              project.location || "N/A",
              project.creator?.name || safeT.common.unknown,
              projectHours[project.id] !== undefined ? `${projectHours[project.id].toFixed(2)}h` : "N/A",
            ]),
            safeT.sections.noCreated
          )}
        </View>

        {/* Projects Scheduled Today */}
        <View style={styles.section}>
          <Text style={styles.sectionHeader}>
          {safeT.sections.scheduledToday} ({scheduledToday.length})
          </Text>
          {renderTable(
            [
              safeT.labels.status.replace(":", ""),
              "Title",
              safeT.labels.location.replace(":", ""),
              safeT.labels.contact.replace(":", ""),
              safeT.labels.totalHours.replace(":", ""),
            ],
            ["15%", "25%", "20%", "20%", "20%"],
            scheduledToday.map((project) => [
              project.status || "N/A",
              project.title || safeT.common.untitled,
              project.location || "N/A",
              project.contact || "N/A",
              projectHours[project.id] !== undefined ? `${projectHours[project.id].toFixed(2)}h` : "N/A",
            ]),
            safeT.sections.noScheduled
          )}
        </View>

        {/* Project User Hours */}
        {renderProjectUserHours()}

        {/* Status Statistics */}
        <View style={[styles.statsBox, { marginTop: 20, marginBottom: 25 }]}>
          <View style={styles.statItem}>
            <Text style={styles.statNumber}>
              {[...createdToday, ...scheduledToday].filter(p => p.status === "activo").length}
            </Text>
            <Text style={styles.statLabel}>{safeT.status.active}</Text>
          </View>
          <View style={styles.statItem}>
            <Text style={styles.statNumber}>
              {[...createdToday, ...scheduledToday].filter(p => p.status === "finalizado").length}
            </Text>
            <Text style={styles.statLabel}>{safeT.status.finished}</Text>
          </View>
          <View style={styles.statItem}>
            <Text style={styles.statNumber}>
              {[...createdToday, ...scheduledToday].filter(p => p.status === "cancelado").length}
            </Text>
            <Text style={styles.statLabel}>{safeT.status.cancelled}</Text>
          </View>
        </View>

        {/* Representatives Section */}
        <View style={{ marginTop: 20 }}>
          <Text style={[styles.sectionHeader, { fontSize: 14, marginBottom: 15 }]}>
            {safeT.representatives.title}
          </Text>
          
          {/* Representatives Statistics */}
          <View style={[styles.statsBox, { marginBottom: 15 }]}>
            <View style={styles.statItem}>
              <Text style={styles.statNumber}>{representativesCreatedToday.length}</Text>
              <Text style={styles.statLabel}>{safeT.representatives.stats.created}</Text>
            </View>
            <View style={styles.statItem}>
              <Text style={styles.statNumber}>{representativesScheduledToday.length}</Text>
              <Text style={styles.statLabel}>{safeT.representatives.stats.scheduled}</Text>
            </View>
            <View style={styles.statItem}>
              <Text style={styles.statNumber}>{representativesCreatedToday.length + representativesScheduledToday.length}</Text>
              <Text style={styles.statLabel}>{safeT.representatives.stats.total}</Text>
            </View>
          </View>
          
          {/* Representatives Created Today */}
          <View style={styles.section}>
            <Text style={styles.sectionHeader}>
              {safeT.representatives.sections.createdToday} (
              {representativesCreatedToday.length})
            </Text>
            {renderTable(
              [
                "Project/Client",
                safeT.labels.visitDate.replace(":", ""),
                safeT.labels.createdBy.replace(":", ""),
              ],
              ["40%", "30%", "30%"],
              representativesCreatedToday.map((rep) => [
                rep.nombre_proyecto || rep.nombre_cliente || safeT.common.untitled,
                rep.fecha_visita ? formatDateShort(rep.fecha_visita) : "N/A",
                (rep.usuario || rep.creator)?.name || safeT.common.unknown,
              ]),
              safeT.representatives.sections.noCreated
            )}
          </View>

          {/* Representatives Scheduled Today */}
          <View style={styles.section}>
            <Text style={styles.sectionHeader}>
              {safeT.representatives.sections.scheduledToday} (
              {representativesScheduledToday.length})
            </Text>
            {renderTable(
              [
                "Project/Client",
                safeT.labels.visitDate.replace(":", ""),
                safeT.labels.contact.replace(":", ""),
              ],
              ["35%", "30%", "35%"],
              representativesScheduledToday.map((rep) => [
                rep.nombre_proyecto || rep.nombre_cliente || safeT.common.untitled,
                rep.fecha_visita ? formatDateShort(rep.fecha_visita) : "N/A",
                rep.persona_contacto || "N/A",
              ]),
              safeT.representatives.sections.noScheduled
            )}
          </View>

          {/* Evaluations Subsection */}
          <View style={{ marginTop: 20 }}>
            <Text style={[styles.sectionHeader, { fontSize: 14, marginBottom: 15 }]}>
              {safeT.evaluations.title}
            </Text>
            
            {/* Evaluations Statistics */}
            <View style={[styles.statsBox, { marginBottom: 15 }]}>
              <View style={styles.statItem}>
                <Text style={styles.statNumber}>{representativesEvaluationsScheduledToday?.length || 0}</Text>
                <Text style={styles.statLabel}>{safeT.evaluations.stats.scheduled}</Text>
              </View>
              <View style={styles.statItem}>
                <Text style={styles.statNumber}>{representativesEvaluatedToday.length}</Text>
                <Text style={styles.statLabel}>{safeT.evaluations.stats.finished}</Text>
              </View>
              <View style={styles.statItem}>
                <Text style={styles.statNumber}>{representativesRejectedToday.length}</Text>
                <Text style={styles.statLabel}>{safeT.evaluations.stats.rejected}</Text>
              </View>
            </View>
            
            {/* Evaluations Scheduled for Today */}
            <View style={styles.section}>
              <Text style={styles.sectionHeader}>
                {safeT.evaluations.sections.scheduledToday} ({representativesEvaluationsScheduledToday?.length || 0})
              </Text>
              {renderTable(
                [
                  "Project/Client",
                  safeT.labels.evaluationScheduled.replace(":", ""),
                  safeT.labels.createdBy.replace(":", ""),
                ],
                ["40%", "30%", "30%"],
                (representativesEvaluationsScheduledToday || []).map((rep) => [
                  rep.nombre_proyecto || rep.nombre_cliente || safeT.common.untitled,
                  rep.fecha_evaluacion ? formatDateShort(rep.fecha_evaluacion) : "N/A",
                  (rep.usuario || rep.creator)?.name || safeT.common.unknown,
                ]),
                safeT.evaluations.sections.noScheduled
              )}
            </View>

            {/* Evaluations Finished */}
            <View style={styles.section}>
              <Text style={styles.sectionHeader}>
                {safeT.evaluations.sections.finishedToday} ({representativesEvaluatedToday.length})
              </Text>
              {renderTable(
                [
                  "Project/Client",
                  safeT.labels.finished.replace(":", ""),
                  safeT.labels.evaluator.replace(":", ""),
                ],
                ["40%", "30%", "30%"],
                representativesEvaluatedToday.map((rep) => [
                  rep.nombre_proyecto || rep.nombre_cliente || safeT.common.untitled,
                  rep.fecha_evaluado ? formatDateShort(rep.fecha_evaluado) : "N/A",
                  rep.nombre_evaluador || "N/A",
                ]),
                safeT.evaluations.sections.noFinished
              )}
            </View>

            {/* Representatives Rejected Today */}
            <View style={styles.section}>
              <Text style={styles.sectionHeader}>
                {safeT.evaluations.sections.rejectedToday} ({representativesRejectedToday.length})
              </Text>
              {renderTable(
                [
                  "Project/Client",
                  safeT.labels.rejected.replace(":", ""),
                ],
                ["60%", "40%"],
                representativesRejectedToday.map((rep) => [
                  rep.nombre_proyecto || rep.nombre_cliente || safeT.common.untitled,
                  rep.fecha_rechazado ? formatDateShort(rep.fecha_rechazado) : "N/A",
                ]),
                safeT.evaluations.sections.noRejected
              )}
            </View>
          </View>
        </View>

        {/* Tools and Teams Section */}
        {/* <View style={{ marginTop: 20 }}>
          <Text style={[styles.sectionHeader, { fontSize: 14, marginBottom: 15 }]}>{safeT.toolsAndTeams.title}</Text>
          
          <View style={[styles.statsBox, { marginBottom: 15 }]}>
            <View style={styles.statItem}>
              <Text style={styles.statNumber}>{_totalTools}</Text>
              <Text style={styles.statLabel}>{safeT.toolsAndTeams.stats.tools}</Text>
            </View>
            <View style={styles.statItem}>
              <Text style={styles.statNumber}>{_totalTeams}</Text>
              <Text style={styles.statLabel}>{safeT.toolsAndTeams.stats.teams}</Text>
            </View>
          </View>

          <View>
            <Text style={[styles.sectionHeader, { fontSize: 12, marginBottom: 10 }]}>
              {safeT.toolsAndTeams.sections.ongoingProjects} ({inProgressProjects.length})
            </Text>
            {renderTable(
              [
                "Project",
                safeT.labels.location.replace(":", ""),
                safeT.labels.team.replace(":", ""),
                safeT.labels.tools.replace(":", ""),
                safeT.labels.totalHoursShort.replace(":", ""),
              ],
              ["25%", "20%", "20%", "20%", "15%"],
              inProgressProjects.map((project) => [
                project.title || safeT.common.untitled,
                project.location || "N/A",
                project.teamMembers && project.teamMembers.length > 0
                  ? project.teamMembers.map((m: any) => m.name).join(", ")
                  : safeT.toolsAndTeams.fields.noTeamAssigned,
                project.projectTools && project.projectTools.length > 0
                  ? project.projectTools.map((pt: any) => `${pt.tool?.nombre} (${pt.cantidadAsignada})`).join(", ")
                  : safeT.toolsAndTeams.fields.noToolsAssigned,
                projectHours[project.id] !== undefined ? `${projectHours[project.id].toFixed(2)}h` : "N/A",
              ]),
              safeT.toolsAndTeams.sections.noInProgress
            )}
          </View>
        </View> */}

        {/* Global Stats */}
        {renderGlobalSection()}

        {/* Footer */}
        <View style={styles.footer}>
          <Text>{safeT.common.generatedOn} {formatDateFooter(new Date())}</Text>
        </View>
      </Page>
    </Document>
  );
};

export default DailyReportPDF;

